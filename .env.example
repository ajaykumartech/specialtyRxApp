# Copy to .env.development / .env.staging / .env.production and fill in.
# EXPO_PUBLIC_ vars are bundled into the app: never put secrets here.
EXPO_PUBLIC_API_URL=https://mock-api.specialtyrx.dev/development/v1
# true = answer every request from src/mocks instead of the network.
EXPO_PUBLIC_USE_MOCKS=true
# development | staging | production (shown on the About screen)
EXPO_PUBLIC_APP_ENV=development
